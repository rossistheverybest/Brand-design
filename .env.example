# --- Supabase (brand-studio project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # server only, never exposed to the browser

# Who may sign in (comma separated)
ALLOWED_EMAILS=you@example.com,office@example.com

# --- Claude (photo checks, copy, rule suggestions) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (optional: "Extend for stories" photo touch-ups) ---
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Meta ---
META_GRAPH_VERSION=v24.0
# Long-lived System User token with: pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish, ads_management, business_management
META_SYSTEM_USER_TOKEN=EAA...

# --- Background jobs ---
# On Netlify: JOB_RUNNER=netlify and SITE_URL=https://<your-site>.netlify.app (or custom domain).
# Anywhere else: leave JOB_RUNNER unset and jobs run in-process after the response.
JOB_RUNNER=netlify
SITE_URL=https://your-site.netlify.app
JOB_SECRET=long-random-string               # protects the background worker endpoint
CRON_SECRET=long-random-string              # only for hosts that call /api/cron/publish over HTTP
