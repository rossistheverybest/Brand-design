# --- Supabase (dedicated project for Brand Studio) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # server only, never exposed to the browser

# Who may sign in (comma separated)
ALLOWED_EMAILS=you@example.com,teammate@example.com

# --- Claude (copy + photo checks) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Meta ---
META_GRAPH_VERSION=v24.0
# A long-lived System User token from Business Settings with:
# pages_manage_posts, pages_read_engagement, instagram_basic,
# instagram_content_publish, ads_management, business_management
META_SYSTEM_USER_TOKEN=EAA...

# Protects the scheduled publish endpoint (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me
